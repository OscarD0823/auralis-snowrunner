{
  "name": "snowrunner-studio-es",
  "productName": "Auralis SnowRunner Studio",
  "version": "2.7.2",
  "description": "Editor visual multilingüe para vehículos, remolques y componentes de SnowRunner.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/OscarD0823/auralis-snowrunner.git"
  },
  "main": ".vite/build/index.cjs",
  "scripts": {
    "icons:generate": "electron scripts/generate-icon.cjs",
    "test:icons": "electron scripts/generate-icon.cjs --check",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "build:exe": "cross-env NODE_ENV=production electron-forge make --platform=win32 --arch=x64",
    "make": "cross-env NODE_ENV=production electron-forge make --platform=win32 --arch=x64",
    "package-prod": "npm i && cross-env NODE_ENV=production electron-forge package --platform=win32 --arch=x64",
    "start": "cross-env NODE_ENV=development electron-forge start",
    "test": "npm run test:archive && npm run test:images && npm run test:pct",
    "test:archive": "esbuild scripts/test-archive.ts --bundle --platform=node --format=esm --outfile=.vite/test-archive.mjs && node .vite/test-archive.mjs",
    "test:images": "esbuild scripts/test-images.ts --bundle --platform=node --format=cjs --external:electron --outfile=.vite/test-images.cjs && electron .vite/test-images.cjs",
    "test:pct": "esbuild scripts/test-pct-images.ts --bundle --platform=node --format=cjs --target=es2022 --external:electron --outfile=.vite/test-pct-images.cjs && electron .vite/test-pct-images.cjs",
    "test:ui": "node scripts/test-ui.mjs && node scripts/test-library-ui.mjs",
    "test:links-ui": "cross-env SNOWRUNNER_LINKS_ONLY=1 node scripts/test-library-ui.mjs",
    "test:updates": "esbuild scripts/test-manual-updates.ts --bundle --platform=node --format=esm --outfile=.vite/test-manual-updates.mjs && node .vite/test-manual-updates.mjs",
    "test:models": "esbuild scripts/test-models.ts --bundle --platform=node --format=esm --external:cheerio --outfile=.vite/test-models.mjs && node .vite/test-models.mjs",
    "lint": "eslint src/**",
    "lint:fix": "npm run lint -- --fix",
    "check": "tsc --project src/tsconfig.json --noEmit && vue-tsc --project src/tsconfig.json --noEmit",
    "test:recovery": "esbuild scripts/test-recovery.ts --bundle --platform=node --format=esm --outfile=.vite/test-recovery.mjs && node .vite/test-recovery.mjs"
  },
  "keywords": [],
  "author": {
    "name": "OscarD0823"
  },
  "license": "MIT",
  "config": {
    "forge": "./src/build-configs/forge.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "sass": "^1.104.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "cheerio": "^1.2.0",
    "debounce": "^3.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "emr-bridge": "^2.0.2",
    "fflate": "^0.8.3",
    "pinia": "^4.0.3",
    "tex-decoder": "^2.0.0",
    "three": "^0.186.1",
    "tslib": "^2.8.1",
    "vue": "^3.5.42",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@cacheable/utils": "2.5.0"
  }
}
